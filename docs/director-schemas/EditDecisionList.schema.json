{
  "$defs": {
    "CreativeBrief": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "0.3.0",
          "default": "0.3.0",
          "title": "Version",
          "type": "string"
        },
        "project_type": {
          "enum": [
            "wedding",
            "restaurant",
            "event",
            "travel",
            "social",
            "couple"
          ],
          "title": "Project Type",
          "type": "string"
        },
        "objective": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "target_seconds": {
          "title": "Target Seconds",
          "type": "string"
        },
        "aspect_ratio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:3"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "fps": {
          "title": "Fps",
          "type": "string"
        },
        "output_width": {
          "default": 3840,
          "exclusiveMinimum": 0,
          "title": "Output Width",
          "type": "integer"
        },
        "output_height": {
          "default": 2160,
          "exclusiveMinimum": 0,
          "title": "Output Height",
          "type": "integer"
        },
        "slow_motion_allowed": {
          "default": false,
          "title": "Slow Motion Allowed",
          "type": "boolean"
        },
        "visual_style": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Visual Style",
          "type": "string"
        },
        "pace": {
          "enum": [
            "slow",
            "balanced",
            "energetic"
          ],
          "title": "Pace",
          "type": "string"
        },
        "narrative_preferences": {
          "items": {
            "type": "string"
          },
          "title": "Narrative Preferences",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "required_candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Required Candidate Ids",
          "type": "array"
        },
        "music_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Music Path"
        },
        "model_id": {
          "enum": [
            "qwen3-vl-8b-instruct",
            "gemma3-12b"
          ],
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "project_type",
        "objective",
        "target_seconds",
        "aspect_ratio",
        "fps",
        "visual_style",
        "pace",
        "model_id"
      ],
      "title": "CreativeBrief",
      "type": "object"
    },
    "EditDecision": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "source_in_frame": {
          "minimum": 0,
          "title": "Source In Frame",
          "type": "integer"
        },
        "source_out_frame": {
          "exclusiveMinimum": 0,
          "title": "Source Out Frame",
          "type": "integer"
        },
        "timeline_start_frame": {
          "minimum": 0,
          "title": "Timeline Start Frame",
          "type": "integer"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "fps": {
          "title": "Fps",
          "type": "string"
        },
        "source_fps": {
          "title": "Source Fps",
          "type": "string"
        },
        "speed": {
          "enum": [
            "1",
            "1/2"
          ],
          "title": "Speed",
          "type": "string"
        },
        "audio_policy": {
          "enum": [
            "preserve",
            "mute_slow_motion"
          ],
          "title": "Audio Policy",
          "type": "string"
        },
        "source_in_seconds": {
          "title": "Source In Seconds",
          "type": "string"
        },
        "source_out_seconds": {
          "title": "Source Out Seconds",
          "type": "string"
        },
        "timeline_start_seconds": {
          "title": "Timeline Start Seconds",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "brief_relation": {
          "title": "Brief Relation",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "score_components": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Score Components",
          "type": "object"
        },
        "refinement": {
          "additionalProperties": true,
          "title": "Refinement",
          "type": "object"
        },
        "music_sync": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Music Sync"
        }
      },
      "required": [
        "candidate_id",
        "asset_id",
        "segment_id",
        "source_in_frame",
        "source_out_frame",
        "timeline_start_frame",
        "duration_frames",
        "fps",
        "source_fps",
        "speed",
        "audio_policy",
        "source_in_seconds",
        "source_out_seconds",
        "timeline_start_seconds",
        "duration_seconds",
        "role",
        "rationale",
        "brief_relation",
        "confidence",
        "score_components",
        "refinement"
      ],
      "title": "EditDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Version",
      "type": "string"
    },
    "brief": {
      "$ref": "#/$defs/CreativeBrief"
    },
    "media": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Media",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/EditDecision"
      },
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "total_frames": {
      "exclusiveMinimum": 0,
      "title": "Total Frames",
      "type": "integer"
    },
    "music": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Music"
    },
    "planning": {
      "additionalProperties": true,
      "title": "Planning",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "brief",
    "media",
    "decisions",
    "total_frames",
    "planning",
    "warnings"
  ],
  "title": "EditDecisionList",
  "type": "object"
}
