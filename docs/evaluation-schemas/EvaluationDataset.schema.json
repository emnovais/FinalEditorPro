{
  "$defs": {
    "EvaluationCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "original_path": {
          "title": "Original Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_group": {
          "minLength": 1,
          "title": "Source Group",
          "type": "string"
        },
        "split": {
          "default": "unassigned",
          "enum": [
            "development",
            "evaluation",
            "unassigned"
          ],
          "title": "Split",
          "type": "string"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "fps": {
          "title": "Fps",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "reference": {
          "$ref": "#/$defs/HumanReference"
        }
      },
      "required": [
        "case_id",
        "original_path",
        "sha256",
        "source_group",
        "fps",
        "start_frame",
        "end_frame"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "HumanFact": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "start_frame",
        "end_frame"
      ],
      "title": "HumanFact",
      "type": "object"
    },
    "HumanReference": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "annotator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotator"
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "evidence_notes": {
          "default": "",
          "title": "Evidence Notes",
          "type": "string"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/HumanFact"
          },
          "title": "Objects",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/HumanFact"
          },
          "title": "Actions",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/HumanFact"
          },
          "title": "Events",
          "type": "array"
        },
        "objects_exhaustive": {
          "default": false,
          "title": "Objects Exhaustive",
          "type": "boolean"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "visual_description": {
          "default": "",
          "title": "Visual Description",
          "type": "string"
        },
        "audio_notes": {
          "default": "",
          "title": "Audio Notes",
          "type": "string"
        },
        "pending_fields": {
          "items": {
            "type": "string"
          },
          "title": "Pending Fields",
          "type": "array"
        }
      },
      "title": "HumanReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "frozen": {
      "default": false,
      "title": "Frozen",
      "type": "boolean"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "cases"
  ],
  "title": "EvaluationDataset",
  "type": "object"
}
